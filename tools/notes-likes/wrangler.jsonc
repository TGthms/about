{
  "name": "notes-likes",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-08",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "notes-likes",
    "database_id": "4f246608-944a-4447-b897-1afcee6c680e"
  }],
  "ratelimits": [{
    "name": "REACTION_LIMIT",
    "namespace_id": "1637218209",
    "simple": { "limit": 20, "period": 60 }
  }, {
    "name": "COMMENT_LIMIT",
    "namespace_id": "1637218210",
    "simple": { "limit": 4, "period": 60 }
  }],
  "vars": { "COMMENTS_OPEN": "true" },
  "observability": { "enabled": false }
}
